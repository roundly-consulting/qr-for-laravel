{
    "name": "roundly-consulting/qr-for-laravel",
    "description": "Native QR codes for Laravel: an ISO/IEC 18004 encoder with optimal segmentation, one optimised SVG renderer, and typed payloads for otpauth 2FA, EPC SEPA transfers and PAY by square — zero third-party dependencies.",
    "keywords": [
        "roundly-consulting",
        "laravel",
        "qr",
        "qr-code",
        "svg",
        "otpauth",
        "2fa",
        "epc",
        "girocode",
        "sepa",
        "pay-by-square",
        "bysquare",
        "iban"
    ],
    "homepage": "https://roundly-consulting.com/open-source/docs/qr-for-laravel",
    "license": "MIT",
    "authors": [
        {
            "name": "Andrej Mihaliak",
            "email": "andrej@mihaliak.com",
            "role": "Developer"
        }
    ],
    "support": {
        "docs": "https://roundly-consulting.com/open-source/docs/qr-for-laravel"
    },
    "require": {
        "php": "^8.4",
        "ext-bcmath": "*",
        "ext-mbstring": "*",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/view": "^12.0|^13.0",
        "roundly-consulting/crypto-for-laravel": "^1.0",
        "roundly-consulting/enums-for-laravel": "^1.0",
        "roundly-consulting/money-for-laravel": "^1.0",
        "roundly-consulting/package-toolkit-for-laravel": "^1.3"
    },
    "require-dev": {
        "ext-dom": "*",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "nunomaduro/collision": "^8.5",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpstan/extension-installer": "^1.4",
        "roundly-consulting/testing-for-laravel": "^1.2"
    },
    "suggest": {
        "ext-intl": "NFC-normalises payment text (EPC/PAY by square) before length checks via \\Normalizer; without it text is encoded exactly as given."
    },
    "autoload": {
        "psr-4": {
            "RoundlyConsulting\\Qr\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RoundlyConsulting\\Qr\\Tests\\": "tests"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse --no-progress",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage --min=90"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "RoundlyConsulting\\Qr\\QrServiceProvider"
            ],
            "aliases": {
                "Qr": "RoundlyConsulting\\Qr\\Facades\\Qr"
            }
        }
    }
}
